APP_NAME="OpenAI Backend"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8765
APP_CURRENT_VERSION=1.0.0
# Only set when a load balancer sits in front of the web server (see README)
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Database (PostgreSQL service of docker-compose.yml). For a quick local run without Docker use:
#   DB_CONNECTION=sqlite  (and `touch database/database.sqlite`)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=openai_api
DB_USERNAME=openai
DB_PASSWORD=secret

CACHE_STORE=file
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

# Docker: host ports of the web server and PostgreSQL, uid/gid of the php container (`id -u`, `id -g`)
WEB_PORT=8765
DB_FORWARD_PORT=5432
LOCAL_UID=1000
LOCAL_GID=1000

# OpenAI
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=30
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_TEMPERATURE=0.7
OPENAI_ALLOWED_MODELS=gpt-3.5-turbo,gpt-4,gpt-4-turbo-preview
OPENAI_HISTORY_LIMIT=50
OPENAI_MESSAGES_PER_MINUTE=20

# API documentation (/docs) is protected with HTTP Basic auth. While the password is empty it stays locked.
DOCS_USERNAME=docs
DOCS_PASSWORD=
DOCS_REQUESTS_PER_MINUTE=30
