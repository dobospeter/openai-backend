{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "dobospeter/openai-backend",
    "type": "project",
    "description": "REST API for chatting with the OpenAI API, built with Laravel using a DDD layout.",
    "keywords": [
        "laravel",
        "rest",
        "ddd",
        "openai"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.10.1",
        "psr/clock": "^1.0",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.14",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.32",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "osteel/openapi-httpfoundation-testing": "^0.15.0",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpunit/phpunit": "^11.5.3",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "cs": "phpcs",
        "cs:fix": "phpcbf",
        "pint": "pint --test app tests bootstrap/app.php bootstrap/providers.php config/docs.php config/openai.php",
        "pint:fix": "pint app tests bootstrap/app.php bootstrap/providers.php config/docs.php config/openai.php",
        "stan": "phpstan analyse --no-progress --memory-limit=1G",
        "check": [
            "@pint",
            "@cs",
            "@stan",
            "@test"
        ],
        "hooks:install": "git config core.hooksPath .githooks",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
