<?xml version="1.0"?>
<ruleset name="OpenAI Backend" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/PHPCSStandards/PHP_CodeSniffer/master/phpcs.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <description>PSR-1 and PSR-12, checked independently of Pint.</description>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="s"/>

    <file>app</file>
    <file>bootstrap/app.php</file>
    <file>bootstrap/providers.php</file>
    <file>config/docs.php</file>
    <file>config/openai.php</file>
    <file>database</file>
    <file>routes</file>
    <file>tests</file>

    <rule ref="PSR12"/>

    <!-- Lines longer than 120 characters are errors (PSR-12 only warns above its soft limit of 120). -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="120"/>
        </properties>
    </rule>
</ruleset>
